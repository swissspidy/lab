{
	"compilerOptions": {
		"target": "ES2024",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": [
			"ES2024",
			"DOM"
		],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"types": [
			"node"
		],
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"noEmit": true
	},
	"include": [
		"packages/*/src",
		"packages/*/test",
		"fixtures/test",
		"fixtures/site/lab.config.ts",
		"fixtures/site/lab/invariants",
		"examples/nextjs/lab/invariants",
		"examples/nextjs/lab.config.ts",
		"examples/run-nextjs.ts",
		"examples/test"
	]
}
